# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pgscout_pw
DB_NAME=pgscout

# Optional — Razorpay (Owner Premium billing). If left blank, premium
# checkout falls back to an instant "mock activation" so the app still
# works end-to-end without a real payment account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — Gmail SMTP (Nodemailer) for email notifications. If left
# blank, the server just logs emails to the console instead of sending
# them, so the app still runs without a mail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional — used as the User-Agent header required by Nominatim's
# usage policy. Set it to your project/contact info before deploying.
NOMINATIM_USER_AGENT=PGScout-Student-Project/1.0 (contact@example.com)
